[Unit]
Description=VortexKV High-Performance In-Memory Data Store & Studio
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vortex
Group=vortex
ExecStart=/usr/local/bin/vortex-server -bind 0.0.0.0 -port 7379 -requirepass "your_strong_password" -maxmemory 4gb -web-port 7380 -aof /var/lib/vortexkv/vortex.aof
Restart=always
RestartSec=3s

# Production Sandboxing & Security Directives
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
